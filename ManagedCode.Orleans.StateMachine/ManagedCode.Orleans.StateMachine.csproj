<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <!--NuGet-->
    <PropertyGroup>
        <Title>ManagedCode.Orleans.StateMachine</Title>
        <PackageId>ManagedCode.Orleans.StateMachine</PackageId>
        <Description>StateMachine implementation on Orleans</Description>
        <PackageTags>managedcode, orleans</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Orleans.Sdk" Version="10.4.0" />
        <PackageReference Include="Microsoft.Orleans.Serialization.Abstractions" Version="10.4.0" />
        <PackageReference Include="Stateless" Version="5.20.1" />
    </ItemGroup>

</Project>
